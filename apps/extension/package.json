{
  "name": "@clarity-compass/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && esbuild src/background.ts src/content.ts src/popup.ts --bundle --format=esm --target=chrome120 --outdir=dist && cp static/* dist/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@qiyas/overlay-sdk": "0.1.2"
  }
}
