# Local development (uv run / pytest)
CLARITY_DATABASE_URL=postgresql+asyncpg://clarity:change-me@127.0.0.1:5432/clarity_dev
CLARITY_TEST_DATABASE_URL=postgresql+asyncpg://clarity:change-me@127.0.0.1:5432/clarity_test

# Shared by docker compose and local runs
POSTGRES_PASSWORD=change-me
CLARITY_SECRET_KEY=            # python -m clarity_api generate-secret
CLARITY_CREDENTIALS_KEY=       # python -m clarity_api generate-secret
CLARITY_ADMIN_USERNAME=admin
CLARITY_ADMIN_PASSWORD_HASH=   # python -m clarity_api hash-password
CLARITY_ARTIFACT_DIR=var/artifacts
CLARITY_SECURE_COOKIES=false   # true behind HTTPS
CLARITY_ALLOWED_NETWORKS=[]    # e.g. ["127.0.0.0/8"] to audit local fixtures
